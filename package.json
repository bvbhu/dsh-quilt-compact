{
  "name": "dsh-quilt-compact",
  "version": "0.1.0",
  "description": "Compaction-chain backend for the DeepSeek Harness: tiered model-pool summarization with per-model cooldown, overlapping chunking, and session-model fallback.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/unit test/e2e",
    "smoke": "node test/smoke/patch.mjs && node test/smoke/compose-web.mjs && node test/smoke/mount.mjs && node test/smoke/volatile-config.mjs && node test/smoke/pool-validation.mjs && node test/smoke/no-double-register.mjs && node test/smoke/client-module.mjs && node test/smoke/client-render.mjs",
    "smoke:patch": "node test/smoke/patch.mjs",
    "smoke:compose-web": "node test/smoke/compose-web.mjs",
    "smoke:mount": "node test/smoke/mount.mjs",
    "smoke:volatile": "node test/smoke/volatile-config.mjs",
    "smoke:pool": "node test/smoke/pool-validation.mjs",
    "smoke:registration": "node test/smoke/no-double-register.mjs",
    "smoke:client": "node test/smoke/client-module.mjs && node test/smoke/client-render.mjs",
    "check": "node --test test/unit test/e2e && npm run smoke"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.7-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-storage": "0.1.7-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.1.7-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "^4.4.3"
  }
}
